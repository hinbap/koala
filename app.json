{
  "expo": {
    "name": "koala",
    "slug": "koala",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/sudoku-alarm/icon.png",
    "scheme": "koala",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.salbap.koala"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/sudoku-alarm/android-icon-foreground.png",
        "backgroundImage": "./assets/sudoku-alarm/android-icon-background.png",
        "monochromeImage": "./assets/sudoku-alarm/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.salbap.koala"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/sudoku-alarm/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1D1A39",
          "image": "./assets/sudoku-alarm/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#1D1A39"
  }
}
