{
  "expo": {
    "name": "koala",
    "slug": "koala",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/sudoku-alarm/icon.png",
    "scheme": "koala",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.salbap.koala"
    },
    "android": {
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM", "android.permission.VIBRATE"],
      "adaptiveIcon": {
        "backgroundColor": "#131312",
        "foregroundImage": "./assets/sudoku-alarm/android-icon-foreground.png",
        "monochromeImage": "./assets/sudoku-alarm/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.salbap.koala"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/sudoku-alarm/favicon.png"
    },
    "plugins": [
      ["expo-image-picker", { "photosPermission": "Choose a photo for your Koala avatar.", "cameraPermission": false, "microphonePermission": false }],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1D1A39",
          "image": "./assets/sudoku-alarm/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-audio",
      ["expo-notifications", { "sounds": ["./assets/sounds/nuclear-notification.wav"] }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#1D1A39"
  }
}
